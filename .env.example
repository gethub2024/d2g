# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real ".env" — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# Developer Portal → your app → Bot → Reset Token
BOT_TOKEN=your_discord_bot_token_here

# Right-click a channel (with Developer Mode on) → Copy Channel ID
CHANNEL_1_ID=your_daily_achievement_channel_id
CHANNEL_2_ID=your_daily_task_channel_id

# Channel where the bot posts its run summary and error embeds
ERROR_CHANNEL_ID=your_error_log_channel_id

# ── Google Sheets ────────────────────────────────────────────
# From the sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here
