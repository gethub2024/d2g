  "main": "index.js",
  "scripts": {
    "start": "node --no-deprecation index.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "google-sheets",
    "googleapis",
    "discordjs",
    "github-actions",
    "logging"
  ],
