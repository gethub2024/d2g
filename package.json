    "type": "git",
    "url": "git+https://github.com/gethub2024/d2g.git"
  },
  "bugs": {
    "url": "https://github.com/gethub2024/d2g/issues"
  },
  "homepage": "https://github.com/gethub2024/d2g#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.15.0",
    "dotenv": "^16.4.7",
    "googleapis": "^134.0.0",
    "moment-timezone": "^0.5.46"
  }
}
